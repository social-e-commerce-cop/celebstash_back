# Server Configuration
# Dynamically binds to Render's $PORT while falling back to 8080 for local development
server.port=${PORT:8080}
spring.application.name=celebstash-backend

# Database Configuration (PostgreSQL)
# For production (Render / Neon / Supabase / RDS), set SPRING_DATASOURCE_URL, SPRING_DATASOURCE_USERNAME, and SPRING_DATASOURCE_PASSWORD
spring.datasource.url=${SPRING_DATASOURCE_URL:${DATABASE_URL:jdbc:postgresql://localhost:5432/celebstash}}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:${DATABASE_USERNAME:postgres}}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:${DATABASE_PASSWORD:REPLACE_WITH_YOUR_POSTGRES_PASSWORD}}
spring.datasource.driver-class-name=org.postgresql.Driver

# Hibernate & JPA Configuration
spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.jpa.show-sql=${SPRING_JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.sql.init.mode=${SPRING_SQL_INIT_MODE:always}

# Redis Configuration (Used for OTP & caching)
spring.data.redis.host=${SPRING_DATA_REDIS_HOST:${REDIS_HOST:localhost}}
spring.data.redis.port=${SPRING_DATA_REDIS_PORT:${REDIS_PORT:6379}}

# JWT Token Configuration (512-bit hex key)
app.jwt.secret=${APP_JWT_SECRET:${JWT_SECRET:404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D635166546A576E5A7234753778214125442A}}
app.jwt.access-token.expiration=${APP_JWT_ACCESS_TOKEN_EXPIRATION:86400000}
app.jwt.refresh-token.expiration=${APP_JWT_REFRESH_TOKEN_EXPIRATION:604800000}

# OTP & Rate Limiting Configuration
app.otp.expiration=${APP_OTP_EXPIRATION:300000}
app.otp.max-attempts=${APP_OTP_MAX_ATTEMPTS:3}
app.otp.rate-limit.per-minute=${APP_OTP_RATE_LIMIT_PER_MINUTE:3}
app.otp.rate-limit.per-day=${APP_OTP_RATE_LIMIT_PER_DAY:10}
# Optional local-development master OTP. MUST stay blank in any deployed environment:
# a code accepted for every identifier allows anyone to complete a password reset for
# any account, including ADMIN. The real OTP is printed to the application log in dev.
app.otp.dev-master-code=${APP_OTP_DEV_MASTER_CODE:}

# Seed Account Configuration (applied only when the account does not already exist).
# Leave blank to have a random password generated and logged once at startup.
app.seed.admin-email=${APP_SEED_ADMIN_EMAIL:admin@example.com}
app.seed.admin-password=${APP_SEED_ADMIN_PASSWORD:}
app.seed.demo-password=${APP_SEED_DEMO_PASSWORD:}

# Twilio Configuration (SMS)
twilio.accountSid=${TWILIO_ACCOUNT_SID:AC00000000000000000000000000000000}
twilio.authToken=${TWILIO_AUTH_TOKEN:dummy_auth_token_32chars_long_000}
twilio.phoneNumber=${TWILIO_PHONE_NUMBER:+15005550006}

# Spring Mail Configuration
spring.mail.host=${SPRING_MAIL_HOST:smtp.gmail.com}
spring.mail.port=${SPRING_MAIL_PORT:587}
spring.mail.username=${SPRING_MAIL_USERNAME:noreply@celebstash.com}
spring.mail.password=${SPRING_MAIL_PASSWORD:placeholder_app_password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# File Upload Configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=150MB
spring.servlet.multipart.max-request-size=150MB
file.upload-dir=${FILE_UPLOAD_DIR:uploads}

# Jackson Configuration
spring.jackson.serialization.fail-on-empty-beans=false

# Spring Boot Actuator Configuration (Health Checks)
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=when_authorized
management.endpoint.health.probes.enabled=true
